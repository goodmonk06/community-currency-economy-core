{
  "name": "community-currency-economy-core",
  "version": "1.0.0",
  "private": true,
  "description": "Community currency economy core engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "cd packages/core && pnpm prisma generate",
    "db:push": "cd packages/core && pnpm prisma db push",
    "db:migrate": "cd packages/core && pnpm prisma migrate dev",
    "db:seed": "cd packages/core && pnpm prisma db seed",
    "db:studio": "cd packages/core && pnpm prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
